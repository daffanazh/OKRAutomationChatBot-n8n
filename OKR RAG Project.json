    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet rawData = \"=== DOKUMEN RAW LAPORAN OKR ===\\n\";\n\nfor (const item of items) {\n    const row = item.json;\n    \n    // Mengambil HANYA isi teks dari setiap sel, membuang sel yang kosong\n    const values = Object.values(row).filter(val => val !== null && val !== undefined && val !== \"\");\n    \n    // Jika baris tersebut ada isinya, gabungkan menjadi satu kalimat\n    if (values.length > 0) {\n        rawData += values.join(\" | \") + \"\\n\";\n    }\n}\n\n// Membungkus seluruh isi dokumen menjadi 1 paket bernama 'okr_data'\nreturn [{\n    json: {\n        okr_data: rawData\n    }\n}];"
      },
